{
  "name": "starscape",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "description": "Graph visualization for very large graphs: a 3D field you fly through.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite demo",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "build": "tsc -p tsconfig.build.json",
    "check": "bash check.sh",
    "build:playground": "vite build",
    "build:api": "typedoc",
    "build:site": "node scripts/build-site.mjs",
    "build:pages": "npm run build:playground && npm run build:api && npm run build:site",
    "preview:pages": "npm run build:pages && vite preview --outDir site-dist --base /starscape/"
  },
  "peerDependencies": {
    "three": ">=0.170.0"
  },
  "devDependencies": {
    "@types/three": "^0.187.0",
    "eslint": "^9",
    "marked": "^18.2.0",
    "three": "^0.187.0",
    "typedoc": "^0.28.20",
    "typescript": "^5",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
